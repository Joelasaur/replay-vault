# Manual production database backup credentials.
#
# Copy to `.env.backup` (git-ignored) and fill in real values.
# Never commit the filled-in file, and never paste these values into chat,
# issues, or CI logs.

# Session Pooler connection string for the self-managed production Supabase
# project. Found in the Supabase dashboard under Connect -> Session pooler.
# Format: postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
SUPABASE_PRODUCTION_DB_URL=

# Expected project ref for production. The backup script refuses to run when
# the connection string above points at a different project.
SUPABASE_PRODUCTION_PROJECT_REF=

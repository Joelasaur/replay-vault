# Copy this file to .env.test.local before running Playwright.
# These deterministic credentials are created by `bun run db:reset` for the
# disposable local stack. Use different ignored values for a hosted preview.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
E2E_TEST_EMAIL=player@replayvault.local
E2E_TEST_PASSWORD=replay-vault-local-only
E2E_BASE_URL=http://localhost:8080
E2E_API_MOCKS=false
E2E_BLOCK_BACKEND=false
